# ======================================================================================================================
# Daftar environment. Copy this file to `.env` (same folder), fill the fields marked FILL IN, and run
#   docker compose up -d --build
# Every other value already has a working development default, so the stack also starts with no .env at all.
# Never commit a real .env (it is ignored by git). The same names are used on Render (API) and Vercel (web); the
# production values are listed in docs/deploy.md and in the PRODUCTION section at the bottom of this file.
# ======================================================================================================================

# --- Ports on this machine ----------------------------------------------------------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=3001
POSTGRES_PORT=5433

# --- Local database passwords (development only) -------------------------------------------------------------------------
POSTGRES_PASSWORD=daftar_dev_password
APP_DB_PASSWORD=daftar_app_dev_password

# --- Security ------------------------------------------------------------------------------------------------------------
# The two long random values below are fine as they are for local work. For production make your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-key-do-not-use-outside-local-development
# Proves to the API that the web server is the real web server. The SAME value must be set on the API and on the web app.
BFF_SHARED_SECRET=dev-bff-shared-secret-for-local-use-only

# --- Display -------------------------------------------------------------------------------------------------------------
DISPLAY_TIMEZONE=Asia/Karachi

# --- Links in emails -----------------------------------------------------------------------------------------------------
# Where invitation and password-reset links point. Locally that is the web app on this machine.
WEB_BASE_URL=http://localhost:3001

# --- Demonstration -------------------------------------------------------------------------------------------------------
# DEMO_MODE lists the four demonstration accounts under the sign-in form. Turn it off for anything real.
DEMO_MODE=true
# `make seed` (docker compose exec backend python -m app.seed) creates these four people. All share one password:
#   daftar-demo-2026
#   admin@daftar.pk      Nadia Qureshi    Admin
#   accounts@daftar.pk   Usman Tariq      Accountant
#   approver@daftar.pk   Ayesha Siddiqui  Approver
#   staff@daftar.pk      Bilal Ahmed      Staff

# ======================================================================================================================
# RECEIPTS: Cloudinary.   Default: memory (kept inside the API, lost on restart except the demonstration receipts).
# To test Cloudinary locally:
#   1. In the Cloudinary dashboard open Settings, then API Keys, and copy the API environment variable (it starts with
#      cloudinary://).
#   2. FILL IN CLOUDINARY_URL below and change STORAGE_BACKEND to cloudinary.
#   3. docker compose up -d --force-recreate backend
#   4. Add a receipt to an expense: it appears in your Cloudinary Media Library under the "daftar" folder, and it is
#      shown in the app (receipts are served only through the API, never by a public link).
# ======================================================================================================================
STORAGE_BACKEND=memory
CLOUDINARY_URL=

# ======================================================================================================================
# EMAIL: SMTP (Google).   Default: console (the message is printed in the API log, nothing is sent).
# To send real email, for example with Google:
#   1. The Google account needs 2-step verification. Then create an app password: Google Account, Security, 2-Step
#      Verification, App passwords. Paste the 16 characters (no spaces) as SMTP_PASS. The normal password does not work.
#   2. SMTP_USER is the Google account. SMTP_FROM_EMAIL must be that address or an alias added under Gmail's "Send mail as".
#   3. Fill in SMTP_USER and SMTP_PASS (that is enough: a login switches sending on), then
#        docker compose up -d --force-recreate backend
#   4. Check it: docker compose exec backend python -m app.mail_check you@example.com
#      It prints whether the server accepted the message, or the server's own reason if not.
# To read mail without sending any: leave SMTP_USER empty, set MAIL_BACKEND=smtp and run
# `docker compose --profile mail up -d`, then open http://localhost:8025 (Mailpit).
# ======================================================================================================================
SMTP_FROM_EMAIL=info@visionpme.ca
SMTP_FROM_NAME=Équipe Vision PME
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Only to force a transport: console or smtp. Normally left empty.
MAIL_BACKEND=

# ======================================================================================================================
# PRODUCTION (reference only: these are NOT read from this file on a host; type them into the dashboards. Full steps:
# docs/deploy.md)
#
# Render (API, from the backend folder)            Vercel (web app, Root Directory: frontend)
#   ENVIRONMENT=production                           API_BASE_URL=https://<your-api>.onrender.com
#   SECRET_KEY=<48+ random characters>               BFF_SHARED_SECRET=<same value as on Render>
#   DATABASE_URL=postgresql+psycopg://daftar_app:..  DISPLAY_TIMEZONE=Asia/Karachi
#   BFF_SHARED_SECRET=<same value as on Vercel>      DEMO_MODE=true for a demonstration site, otherwise false
#   WEB_BASE_URL=https://<your-app>.vercel.app
#   STORAGE_BACKEND=cloudinary
#   CLOUDINARY_URL=cloudinary://...
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_SECURE=false
#   SMTP_USER=<google account>   SMTP_PASS=<app password>
#   SMTP_FROM_EMAIL=info@visionpme.ca   SMTP_FROM_NAME=Équipe Vision PME
#   DISPLAY_TIMEZONE=Asia/Karachi
#
# Running the migrations and the one-off demo seed against the live database use a separate, git-ignored file named
# .env.deploy (see docs/deploy.md, steps 2 and 3); it also holds MIGRATION_DATABASE_URL and ALLOW_DEMO_SEED.
# ======================================================================================================================
