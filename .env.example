# Copy this file to .env and change what you need. Every value has a working development default, so the stack also
# starts with no .env at all (docker compose up -d --build). Never commit a real .env.

# --- Ports on this machine ---------------------------------------------------------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=3001
POSTGRES_PORT=5433

# --- Database passwords (development only; production uses its own) --------------------------------------------------------
POSTGRES_PASSWORD=daftar_dev_password
APP_DB_PASSWORD=daftar_app_dev_password

# --- Security --------------------------------------------------------------------------------------------------------------
# Production refuses a weak SECRET_KEY: at least 32 characters, mixed, with no word like "secret" or "changeme".
SECRET_KEY=dev-only-key-do-not-use-outside-local-development
# Proves to the API that a client address forwarded by the web server is real. Generate a long random value and set the
# same one on the web server and the API.
BFF_SHARED_SECRET=dev-bff-shared-secret-for-local-use-only

# --- Display ---------------------------------------------------------------------------------------------------------------
DISPLAY_TIMEZONE=Asia/Karachi

# --- Demonstration ---------------------------------------------------------------------------------------------------------
# DEMO_MODE shows the demonstration accounts under the sign-in form. Turn it off for anything real.
DEMO_MODE=true
# `make seed` (docker compose exec backend python -m app.seed) creates these four people. All share one password:
#   daftar-demo-2026
#   admin@daftar.pk      Nadia Qureshi    Admin
#   accounts@daftar.pk   Usman Tariq      Accountant
#   approver@daftar.pk   Ayesha Siddiqui  Approver
#   staff@daftar.pk      Bilal Ahmed      Staff

# --- Receipts --------------------------------------------------------------------------------------------------------------
# memory keeps receipts inside the API process (development: lost on restart, except the demonstration ones, which are
# redrawn). cloudinary keeps them for good and needs CLOUDINARY_URL.
STORAGE_BACKEND=memory
CLOUDINARY_URL=

# --- Email -----------------------------------------------------------------------------------------------------------------
# console logs the message (development). smtp sends to Mailpit (docker compose --profile mail up). resend needs a key.
MAIL_BACKEND=console
MAIL_FROM=Daftar <no-reply@daftar.pk>
SMTP_HOST=mailpit
RESEND_API_KEY=
